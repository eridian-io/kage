{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": ".tsc",
    "emitDeclarationOnly": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "*.ts",
    "../playwright.config.ts",
    "../packages/web/sizes.ts",
    "../packages/server/test/setup-fetch.ts",
    "../packages/server/src/install/runtime.ts",
    "../packages/server/src/tmux/test-sockets.ts",
    "../packages/server/test/tmux-global.ts"
  ]
}
