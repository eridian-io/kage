#!/bin/sh
# A fake `systemctl --user` for pnpm test:install, where systemd doesn't run. Starting a unit runs
# exactly what its file says: ExecStart='s words with Environment='s words and nothing else of the
# caller's environment (env -i, plus what a user manager sets: HOME, USER, LOGNAME, SHELL and
# XDG_RUNTIME_DIR), in its own session, its output in a journal file. Stopping signals the main
# process only (Restart= and the cgroup aren't emulated; pnpm test:reboot runs the real systemd).
# Every call is logged, so the check can see a restart.
set -u
state=${XDG_RUNTIME_DIR:-/tmp}/fake-systemd
# The manager's own unit folder: a user manager has no XDG_CONFIG_HOME, whatever the caller's (R125).
units=$HOME/.config/systemd/user
mkdir -p "$state"
echo "systemctl $*" >>"$state/calls"

[ "${1:-}" = --user ] || { echo 'fake systemctl: only --user' >&2; exit 1; }
shift
cmd=${1:-}
[ $# -gt 0 ] && shift
now=
unit=
for a in "$@"; do
  case $a in --now) now=1 ;; -*) ;; *) unit=$a ;; esac
done
file=$units/$unit
pidfile=$state/$unit.pid

running() {
  [ -f "$pidfile" ] || return 1
  pid=$(cat "$pidfile")
  kill -0 "$pid" 2>/dev/null || return 1
  # A zombie isn't running.
  case $(ps -o stat= -p "$pid" 2>/dev/null) in Z*) return 1 ;; esac
  return 0
}

# The words of a unit line ($1=, the first one), read the way systemd reads them: "…" or '…'
# words, \x escapes, %% for %, and in ExecStart= $$ for $ ($2 = exec or env). One per line.
words() {
  awk -v key="$1" -v ctx="$2" -v sq="'" '
    index($0, key "=") == 1 && !done {
      done = 1; s = substr($0, length(key) + 2); n = length(s); i = 1
      while (i <= n) {
        while (i <= n && substr(s, i, 1) ~ /[ \t]/) i++
        if (i > n) break
        q = ""; c = substr(s, i, 1)
        if (c == "\"" || c == sq) { q = c; i++ }
        w = ""
        while (i <= n) {
          c = substr(s, i, 1); d = substr(s, i + 1, 1)
          if (q != "" ? c == q : c ~ /[ \t]/) { if (q != "") i++; break }
          if (c == "\\" && d != "") { w = w d; i += 2 }
          else if (c == "%" && d == "%") { w = w "%"; i += 2 }
          else if (ctx == "exec" && c == "$" && d == "$") { w = w "$"; i += 2 }
          else { w = w c; i++ }
        }
        print w
      }
    }' "$file"
}

start() {
  running && return 0
  [ -f "$file" ] || { echo "Unit $unit not found." >&2; return 5; }
  set -- env -i "HOME=$HOME" "USER=${USER:-dev}" "LOGNAME=${LOGNAME:-dev}" "SHELL=${SHELL:-/bin/sh}" \
    "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
  while IFS= read -r w; do set -- "$@" "$w"; done <<EOF
$(words Environment env)
EOF
  while IFS= read -r w; do set -- "$@" "$w"; done <<EOF
$(words ExecStart exec)
EOF
  # No job control here, so the child isn't a group leader and setsid execs in place: $! is it.
  setsid "$@" >>"$state/$unit.journal" 2>&1 </dev/null &
  echo $! >"$pidfile"
  return 0
}

stop() {
  running || { rm -f "$pidfile"; return 0; }
  kill -TERM "$pid" 2>/dev/null
  i=0
  while running && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  running && kill -KILL "$pid" 2>/dev/null
  rm -f "$pidfile"
  return 0
}

wants=$units/default.target.wants
case $cmd in
  daemon-reload) exit 0 ;;
  # Only `show -p UnitPath --value`: the manager's search path, in systemd 255's order, so the
  # first user entry outside /etc, /run, /usr and /lib is $units (R125).
  show)
    [ "$*" = '-p UnitPath --value' ] || { echo "fake systemctl: no show $*" >&2; exit 1; }
    rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    echo "$units.control $rt/systemd/user.control $rt/systemd/transient $rt/systemd/generator.early $units /etc/systemd/user $rt/systemd/user /run/systemd/user $HOME/.local/share/systemd/user /usr/local/share/systemd/user /usr/share/systemd/user /usr/local/lib/systemd/user /usr/lib/systemd/user $rt/systemd/generator.late"
    exit 0 ;;
  is-active)
    if running; then echo active; exit 0; fi
    echo inactive; exit 3 ;;
  start) start; exit $? ;;
  stop) stop; exit 0 ;;
  restart) stop; start; exit $? ;;
  enable)
    [ -f "$file" ] || { echo "Unit $unit not found." >&2; exit 1; }
    mkdir -p "$wants" && ln -sf "$file" "$wants/$unit"
    [ -z "$now" ] || start
    exit $? ;;
  disable)
    rm -f "$wants/$unit"
    [ -z "$now" ] || stop
    exit 0 ;;
  *) echo "fake systemctl: no $cmd" >&2; exit 1 ;;
esac
