{
  "name": "kage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "node packages/web/build.ts && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @kage/server build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:linux": "bash scripts/test-linux.sh",
    "test:install": "bash scripts/test-install.sh",
    "test:reboot": "bash scripts/test-reboot.sh",
    "release:local": "pnpm build && node packages/server/src/release/build.ts --out dist/release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
