{
  "name": "kage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "node packages/web/build.ts && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @kage/server build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:linux": "bash scripts/test-linux.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
